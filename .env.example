# Copia este archivo como .env y completa tus valores
OPENAI_API_KEY=tu_api_key_aqui
OPENAI_MODEL=gpt-5-mini
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/nombre_bd
CHAT_DATABASE_URL=postgresql+asyncpg://chatdb:contraseña@chat-db:5432/chat_db
CHAT_DB_USER=chatdb
CHAT_DB_PASSWORD=contraseña
CHAT_DB_NAME=chat_db
# CORS (orígenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Logs (opcional)
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
